QDRANT_URL="http://localhost:6333/"
QDRANT_API_KEY=""
Gemini_ai_key=""
GROQ_API_KEY=""

# --- Blob Storage (backend/services/blob_storage.py) ---
# Container that holds jewelry images. Same value in every environment.
AZURE_STORAGE_CONTAINER="jewellery-data"

# Local dev / docker-compose (Azurite emulator) - connection string with the
# emulator's well-known, publicly-documented key. Never use a connection
# string like this in production.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"

# Production - set this INSTEAD of AZURE_STORAGE_CONNECTION_STRING (leave the
# connection string unset/removed). The app then authenticates with
# DefaultAzureCredential - a managed identity on App Service/AKS/VM granted
# "Storage Blob Data Contributor" on the account - so no storage key is ever
# stored in an env var or secret store.
# AZURE_STORAGE_ACCOUNT_URL="https://<your-storage-account>.blob.core.windows.net"

# Only used one-time by backend/scripts/migrate_to_real_azure.py, to copy
# everything out of the local Azurite container into a real Azure Storage
# account (see DEPLOYMENT_STRUCTURE.md). Not read by the running app.
# AZURE_STORAGE_DEST_ACCOUNT_URL="https://<your-storage-account>.blob.core.windows.net"
